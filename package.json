{
  "name": "@teamimpact/veda-tools",
  "description": "A React UI component library to build custom-interfaces for GIS application.",
  "version": "0.1.0-alpha.5",
  "author": "<sanzog03@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/NASA-IMPACT/veda-tools.git"
  },
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/NASA-IMPACT/veda-tools.git",
  "exports": {
    ".": {
      "import": "./dist/main/index.js",
      "require": "./dist/main/index.js"
    },
    "./components/core": {
      "import": "./dist/components/core/index.js",
      "require": "./dist/components/core/index.js"
    },
    "./components/ui": {
      "import": "./dist/components/ui/index.js",
      "require": "./dist/components/ui/index.js"
    },
    "./components/method": {
      "import": "./dist/components/method/index.js",
      "require": "./dist/components/method/index.js"
    },
    "./interfaces/emit": {
      "import": "./dist/components/interfaces/emit/index.js",
      "require": "./dist/components/interfaces/emit/index.js"
    },
    "./interfaces/noaa": {
      "import": "./dist/components/interfaces/noaa/index.js",
      "require": "./dist/components/interfaces/noaa/index.js"
    },
    "./interfaces/goes": {
      "import": "./dist/components/interfaces/goes/index.js",
      "require": "./dist/components/interfaces/goes/index.js"
    },
    "./interfaces/nist": {
      "import": "./dist/components/interfaces/nist/index.js",
      "require": "./dist/components/interfaces/nist/index.js"
    },
    "./interfaces/urban": {
      "import": "./dist/components/interfaces/urban/index.js",
      "require": "./dist/components/interfaces/urban/index.js"
    },
    "./interfaces/cloudBrowse": {
      "import": "./dist/components/interfaces/cloudBrowse/index.js",
      "require": "./dist/components/interfaces/cloudBrowse/index.js"
    }
  },
  "targets": {
    "main": {
      "source": "src/lib/index.ts",
      "distDir": "dist/main",
      "context": "node",
      "isLibrary": true
    },
    "ui": {
      "source": "src/components/ui/index.ts",
      "distDir": "dist/components/ui",
      "context": "node",
      "isLibrary": true
    },
    "method": {
      "source": "src/components/method/index.ts",
      "distDir": "dist/components/method",
      "context": "node",
      "isLibrary": true
    },
    "core": {
      "source": "src/components/core/index.ts",
      "distDir": "dist/components/core",
      "context": "node",
      "isLibrary": true
    },
    "emit": {
      "source": "src/components/interfaces/emit/src/lib/index.ts",
      "distDir": "dist/components/interfaces/emit",
      "context": "node",
      "isLibrary": true
    },
    "noaa": {
      "source": "src/components/interfaces/noaa/src/lib/index.ts",
      "distDir": "dist/components/interfaces/noaa",
      "context": "node",
      "isLibrary": true
    },
    "goes": {
      "source": "src/components/interfaces/goes/goes-plume-viewer/src/lib/index.ts",
      "distDir": "dist/components/interfaces/goes",
      "context": "node",
      "isLibrary": true
    },
    "nist": {
      "source": "src/components/interfaces/nist/nist-interface/src/lib/index.ts",
      "distDir": "dist/components/interfaces/nist",
      "context": "node",
      "isLibrary": true
    },
    "urban": {
      "source": "src/components/interfaces/urban/urban-dashboard/src/lib/index.ts",
      "distDir": "dist/components/interfaces/urban",
      "context": "node",
      "isLibrary": true
    },
    "cloudBrowse": {
      "source": "src/components/interfaces/cloudBrowse/src/components/index.js",
      "distDir": "dist/components/interfaces/cloudBrowse",
      "context": "node",
      "isLibrary": true
    }
  },
  "scripts": {
    "start": "parcel",
    "build-lib": "yarn gulp",
    "build": "parcel build",
    "build:main": "parcel build main",
    "build:components": "parcel build components",
    "clean": "rm -rf node_modules  dist yarn.lock package-lock.json .parcel-cache  && yarn cache clean",
    "release": "release-it --ci",
    "release-beta": "release-it --preRelease=beta --ci",
    "pre-release-alpha": "release-it --preRelease=alpha --ci --no-git.requireBranch",
    "pre-release-rc": "release-it --preRelease=rc --ci --no-git.requireBranch",
    "release-test": "release-it --dry-run",
    "release-first-version": "release-it major",
    "watch": "parcel watch",
    "test": "jest",
    "format": "prettier --write .",
    "lint": "eslint src",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "fix-conflicts": "prettier --write . && eslint . --fix"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "styled-components": "^5",
    "conventional-changelog-conventionalcommits": "8.0.0"
  },
  "dependencies": {
    "@date-io/moment": "^3.0.0",
