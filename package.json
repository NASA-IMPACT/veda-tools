    "release-it": "^18.1.2",
    "semver": "^7.7.1",
    "typescript": "^4.4.2"
  },
  "peerDependencies": {
    "@mui/material": "^6.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "alias": {
    "$components": "./src/components",
    "$context": "./src/context/"
  }
}
