    "file-saver": "^2.0.5",
    "font-awesome": "^4.7.0",
    "font-awesome-icons": "^1.6.0",
    "gulp": "^5.0.1",
    "jquery": "^3.7.1",
    "jszip": "^3.10.1",
    "luxon": "^3.5.0",
    "mapbox-gl": "^3.7.0",
    "mapboxgl-timeline": "^1.0.2",
    "material-ui-popup-state": "^5.1.2",
    "moment": "^2.30.1",
    "ncp": "^2.0.0",
    "pdfjs-dist": "^3.5.141",
    "prettier": "^2.8.8",
    "print-js": "^1.6.0",
    "rc-progress": "^3.4.2",
    "react-chartjs-2": "^5.2.0",
    "react-helmet": "^6.1.0",
